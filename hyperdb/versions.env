# Pinned versions of hyperdb. Change here, rebuild with ./build.sh.
PG_VERSION=18.6
PGVECTOR_VERSION=0.8.1
PG_CRON_VERSION=1.6.8
PG_IVM_VERSION=1.13
PG_SEARCH_VERSION=0.21.8
# pg_search pins its pgrx in Cargo.toml; cargo-pgrx must match exactly.
PGRX_VERSION=0.16.1

# sha256 of the source archives (./sums.sh --update rewrites these after a version bump).
PG_SHA256=555610c24d53e4316da5b7d3fc25c279d96856d5e0e23ee308c328c5fa881d9f
PGVECTOR_SHA256=a9094dfb85ccdde3cbb295f1086d4c71a20db1d26bf1d6c39f07a7d164033eb4
PG_CRON_SHA256=c19ab9bb35406c60fb51ecda993737c083850abe424acb6c1030439d00a1f8e4
PG_IVM_SHA256=0868e5f6473d5de70e5314decd221ce4e7d2e1326ee99384fd593a0866bca1ab
PG_SEARCH_SHA256=30c3662139ef0ded39dfe3b9053317ab848acc8bc2180bf38864e0dc4417d6be
# Package revision: bump when the build changes without a version change.
HYPERDB_REVISION=1
